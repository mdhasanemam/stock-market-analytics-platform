# Copy to .env — never commit the real file.
ENVIRONMENT=development
LOG_LEVEL=INFO

# yfinance = live Yahoo Finance data (needs internet) | csv = bundled historical sample (offline demo, ends 2017-11)
DATA_PROVIDER=yfinance
CACHE_TTL_MINUTES=30

# SQLite by default. For PostgreSQL: postgresql+psycopg://user:password@host:5432/dbname (add psycopg to requirements)
DATABASE_URL=sqlite:///./data/app.db

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_PER_MINUTE=120

# ML tuning
ML_TRAIN_WINDOW=1500
ML_REFIT_EVERY=25
ML_MAX_TEST_DAYS=250
